# TrailBase configuration (protobuf text format).
# Schema: https://github.com/trailbaseio/trailbase/blob/main/crates/core/proto/config.proto
#
# The `todos` entry exposes the `todos` SQLite table over the REST records API
# with anonymous (world) create/read/update/delete access so the demo runs
# without sign-in, exactly like the Supabase demo's `to anon` RLS policies and
# the Nhost demo's public role. `enable_subscriptions` turns on realtime SSE.
email {}
server {
  application_name: "Little Things"
  logs_retention_sec: 604800
}
auth {
  auth_token_ttl_sec: 3600
  refresh_token_ttl_sec: 2592000
}
jobs {}
record_apis: [
  {
    name: "todos"
    table_name: "todos"
    enable_subscriptions: true
    acl_world: [ READ, CREATE, UPDATE, DELETE, SCHEMA ]
  }
]
